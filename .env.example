NODE_ENV=development

API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stockanalyzer

# SSI iBoard public API — no API key required. See docs/provider-ssi-iboard.md
MARKET_DATA_BASE_URL=https://iboard-api.ssi.com.vn
MARKET_DATA_API_KEY=
MARKET_DATA_PROVIDER=mock

# LLM_PROVIDER: none | openai | anthropic
# For anthropic: set LLM_API_KEY to your Anthropic API key, LLM_MODEL defaults to claude-opus-5-5
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

MARKET_DATA_TIMEOUT_MS=10000
MARKET_DATA_CACHE_TTL_SECONDS=300
LLM_TIMEOUT_MS=30000
